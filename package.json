{
  "name": "idbport",
  "description": "Import and export your IndexedDB data",
  "author": "rxliuli",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:safari": "wxt zip -b safari",
    "test": "vitest run",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:browser": "vitest --workspace=vitest.workspace.ts"
  },
  "dependencies": {
    "@extport/sdk": "^0.0.9",
    "@rxliuli/file-saver": "^2.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@webext-core/messaging": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "devaluex": "^0.2.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-use": "^17.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.16.1"
  },
  "devDependencies": {
    "@extport/wxt": "^0.0.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/browser-preview": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "wxt": "^0.21.3"
  }
}
